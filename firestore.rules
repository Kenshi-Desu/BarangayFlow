rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════
    //  HELPER FUNCTIONS
    // ═══════════════════════════════════════════════════════

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function adminData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function adminExists() {
      return isAuth()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasRole(role) {
      return adminExists() && adminData().role == role;
    }

    function isAdmin()        { return hasRole("admin"); }
    function isIT()           { return hasRole("it");    }
    function isStaff()        { return hasRole("staff"); }
    function isStaffOrAbove() {
      return adminExists()
        && adminData().role in ["staff", "admin", "it"];
    }

    function validResidentSectors(sectors) {
      return sectors is list
        && sectors.size() > 0
        && sectors.size() <= 7
        && sectors.toSet().hasOnly([
          "General Resident/Citizen", "Senior Citizen",
          "Person with Disability (PWD)", "Student", "Solo Parent",
          "4Ps Beneficiary", "Other"
        ]);
    }

    function validResidentIdUrl(url) {
      return url is string
        && url.matches('^https://res[.]cloudinary[.]com/dqlei56w3/.*$');
    }

    function validResidentRegistration() {
      let resident = request.resource.data;
      return resident.keys().hasOnly([
          "firstName", "middleName", "lastName", "gender", "civilStatus",
          "birthDate", "placeOfBirth", "sector", "email", "phone", "landline",
          "address", "emailVerified", "active", "accountStatus", "idPhotoUrl",
          "idPhotoPublicId", "idFileName", "createdAt"
        ])
        && resident.keys().hasAll([
          "firstName", "middleName", "lastName", "gender", "civilStatus",
          "birthDate", "placeOfBirth", "sector", "email", "phone", "landline",
          "address", "emailVerified", "active", "accountStatus", "idPhotoUrl",
          "idPhotoPublicId", "idFileName", "createdAt"
        ])
        && resident.active == false
        && resident.accountStatus == "pending_verification"
        && resident.emailVerified == true
        && resident.createdAt == request.time
        && resident.firstName is string
        && resident.middleName is string
        && resident.lastName is string
        && resident.gender is string
        && resident.civilStatus is string
        && resident.birthDate is string
        && resident.placeOfBirth is string
        && resident.email is string
        && resident.phone is string
        && resident.landline is string
        && resident.address is string
        && validResidentSectors(resident.sector)
        && validResidentIdUrl(resident.idPhotoUrl)
        && resident.idPhotoPublicId is string
        && resident.idFileName is string;
    }

    function validResidentProfileChangeRequest() {
      let profile = request.resource.data.profileChangeRequest;
      return profile is map
        && profile.keys().hasOnly([
          "firstName", "middleName", "lastName", "gender", "civilStatus",
          "birthDate", "placeOfBirth", "phone", "landline", "address",
          "sector", "idPhotoUrl", "idPhotoPublicId", "idFileName",
          "status", "submittedAt"
        ])
        && profile.keys().hasAll([
          "firstName", "middleName", "lastName", "gender", "civilStatus",
          "birthDate", "placeOfBirth", "phone", "landline", "address",
          "sector", "idPhotoUrl", "idPhotoPublicId", "idFileName",
          "status", "submittedAt"
        ])
        && profile.firstName is string
        && profile.middleName is string
        && profile.lastName is string
        && profile.gender is string
        && profile.civilStatus is string
        && profile.birthDate is string
        && profile.placeOfBirth is string
        && profile.phone is string
        && profile.landline is string
        && profile.address is string
        && validResidentSectors(profile.sector)
        && validResidentIdUrl(profile.idPhotoUrl)
        && profile.idPhotoPublicId is string
        && profile.idFileName is string
        && profile.status == "pending"
        && profile.submittedAt == request.time;
    }

    // ═══════════════════════════════════════════════════════
    //  USERS
    //  Residents own their profile; staff+ can read all.
    // ═══════════════════════════════════════════════════════
    match /users/{userId} {
      allow read:   if isOwner(userId) || isStaffOrAbove();
      allow create: if isOwner(userId) && validResidentRegistration();

      // Residents can only submit a proposed profile with a replacement ID.
      // Authoritative profile and verification fields remain staff-controlled.
      allow update: if isStaffOrAbove()
        || (
          isOwner(userId)
          && (!("active" in resource.data) || resource.data.active == true)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["profileChangeRequest"])
          && validResidentProfileChangeRequest()
          && (
            !("profileChangeRequest" in resource.data)
            || resource.data.profileChangeRequest.status != "pending"
          )
        );

      allow delete: if isAdmin() || isIT();
    }

    // ═══════════════════════════════════════════════════════
    //  ADMINS
    // ═══════════════════════════════════════════════════════
    match /admins/{adminId} {
      allow read:   if isOwner(adminId) || isAdmin() || isIT();
      allow create: if isIT();
      allow update: if isIT()
                    || (isAdmin() && !("role" in request.resource.data));
      allow delete: if isIT();
    }

    // ═══════════════════════════════════════════════════════
    //  REQUESTS
    //
    //  READ    : resident reads own 24/7; staff reads all.
    //  CREATE  : resident — any time (gentle reminder shown client-side).
    //            staff   — any time (walk-ins, corrections).
    //  UPDATE  : resident — own Pending requests only.
    //            staff   — any time (status, docVerification,
    //                      docInvalidReason, pickup schedule …).
    //  DELETE  : resident — own Pending only; admin/IT any.
    // ═══════════════════════════════════════════════════════
    match /requests/{requestId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid
        || isStaffOrAbove()
      );

      allow create: if isAuth() && (
        request.resource.data.userId == request.auth.uid
        || isStaffOrAbove()
      );

      allow update: if isAuth() && (
        (
          resource.data.userId == request.auth.uid
          && resource.data.status == "Pending"
        )
        || isStaffOrAbove()
      );

      allow delete: if isAuth() && (
        ( resource.data.userId == request.auth.uid
          && resource.data.status == "Pending" )
        || isAdmin()
        || isIT()
      );
    }

    // ═══════════════════════════════════════════════════════
    //  SERVICES — read by all authenticated; written by admin.
    // ═══════════════════════════════════════════════════════
    match /services/{serviceId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════
    //  ANNOUNCEMENTS
    // ═══════════════════════════════════════════════════════
    match /announcements/{annId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════
    //  SYSTEM CONFIG — public read (maintenance flag); IT write.
    // ═══════════════════════════════════════════════════════
    match /system/{docId} {
      allow read:  if true;
      allow write: if isIT();
    }

    // ═══════════════════════════════════════════════════════
    //  AUDIT LOGS
    // ═══════════════════════════════════════════════════════
    match /logs/{logId} {
      allow read:   if isAdmin() || isIT();
      allow create: if isStaffOrAbove();
      allow update: if false;
      allow delete: if isIT();
    }


    // ═══════════════════════════════════════════════════════
    //  DOCUMENT TEMPLATES  (NEW — Dynamic Template System)
    //
    //  Staff+ can read at print time (review.js / it.js).
    //  Only barangay-admin can create / update / delete.
    //  Version sub-collection is immutable once written.
    // ═══════════════════════════════════════════════════════
    match /documentTemplates/{tplId} {
      allow read:   if isStaffOrAbove();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();

      match /versions/{versionId} {
        allow read:   if isStaffOrAbove();
        allow create: if isAdmin();
        allow update: if false;        // immutable
        allow delete: if isAdmin();
      }
    }

    // ═══════════════════════════════════════════════════════
    //  BACKUPS — IT only
    // ═══════════════════════════════════════════════════════
    match /backups/{docId}    { allow read, write: if isIT(); }
    match /backupMeta/{docId} { allow read, write: if isIT(); }

    // ═══════════════════════════════════════════════════════
    //  PENDING ADMINS (registration queue before IT approval)
    // ═══════════════════════════════════════════════════════
    match /pendingAdmins/{uid} {
      allow create: if isAuth() && request.auth.uid == uid;
      allow read:   if isOwner(uid) || isIT();
      allow update: if isIT();
      allow delete: if isIT();
    }

    // ═══════════════════════════════════════════════════════
    //  KIOSK REQUESTS
    //
    //  READ   : Barangay Staff & Barangay Admin only.
    //  CREATE : Public kiosk submissions (walk-in or signed-in).
    //  UPDATE : Staff & Admin may mark a kiosk request Completed.
    //  DELETE : Disabled (immutable kiosk queue records).
    // ═══════════════════════════════════════════════════════
    match /kioskRequests/{kioskId} {
      allow read: if isStaff() || isAdmin();
      allow create: if request.resource.data.source == "kiosk"
        && (!("status" in request.resource.data) || request.resource.data.status == "Pending")
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 200
        && request.resource.data.contact is string
        && request.resource.data.contact.matches('^09[0-9]{9}$')
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0
        && request.resource.data.address.size() <= 500
        && request.resource.data.purpose is string
        && request.resource.data.purpose.size() > 0
        && request.resource.data.purpose.size() <= 500
        && request.resource.data.queueNumber is string
        && request.resource.data.queueNumber.size() > 0
        && request.resource.data.queueNumber.size() <= 20
        && request.resource.data.kioskReference is string
        && request.resource.data.kioskReference.size() > 0
        && request.resource.data.kioskReference.size() <= 40
        && request.resource.data.serviceType is string
        && request.resource.data.serviceType.size() > 0
        && request.resource.data.serviceType.size() <= 2000
        && request.resource.data.documents is list
        && request.resource.data.documents.size() > 0
        && request.resource.data.documents.size() <= 20;
      allow update: if (isStaff() || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "completedAt", "completedBy", "updatedAt"
        ])
        && request.resource.data.status == "Completed";
      allow delete: if false;
    }

  }
}
